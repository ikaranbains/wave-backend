# Server & Database
PORT=5000
MONGODB_URI=mongodb://localhost:27017/wave
CORS_ORIGIN=http://localhost:3000

# Authentication & Session
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key
AUTH_COOKIE_SAME_SITE=lax

# Cloudinary (File/Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# LiveKit (Audio/Video Calling)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Firebase Cloud Messaging (Push Notifications)
# FIREBASE_SERVICE_ACCOUNT: Firebase console > Project settings > Service accounts >
#   "Generate new private key", then base64-encode the downloaded JSON:
#     node -e "console.log(Buffer.from(require('fs').readFileSync(process.argv[1])).toString('base64'))" service-account.json
#   Raw one-line JSON also works. Keep the .json file out of git.
# FIREBASE_VAPID_KEY: Project settings > Cloud Messaging > Web Push certificates >
#   the public "Key pair" value. Served to the browser for getToken({ vapidKey }).
FIREBASE_SERVICE_ACCOUNT=base64_encoded_service_account_json
FIREBASE_VAPID_KEY=your_firebase_web_push_public_key

# Absolute HTTPS origin of the web app. Optional: enables notification click-through.
APP_BASE_URL=http://localhost:3000

# Password reset backup codes, comma-separated and single-use. Generate with:
#   node scripts/generateResetCodes.js
PASSWORD_RESET_BACKUP_CODES=
